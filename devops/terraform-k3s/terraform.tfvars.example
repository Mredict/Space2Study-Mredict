aws_region   = "eu-central-1"
project_name = "space2study"
environment  = "dev"

# curl -s ifconfig.me   -> then append /32
api_server_allowed_cidrs = ["203.0.113.4/32"]

control_plane_instance_type = "t3.small"
worker_instance_type        = "t3.small"
worker_count                = 2
root_volume_gb        = 20
mongo_data_volume_gb  = 15

budget_limit_usd     = 100
budget_alert_emails  = ["you@example.com"]
discord_webhook_url  = "https://discord.com/api/webhooks/xxx/yyy"

db_username = "dbadmin"
db_password = "CHANGE_ME"

jwt_access_secret  = "CHANGE_ME"
jwt_refresh_secret = "CHANGE_ME"
jwt_reset_secret   = "CHANGE_ME"
jwt_confirm_secret = "CHANGE_ME"

mail_user = "notifications@yourdomain.com"
mail_pass = "CHANGE_ME"

gmail_client_id     = "CHANGE_ME"
gmail_client_secret = "CHANGE_ME"
gmail_refresh_token = "CHANGE_ME"
gmail_redirect_uri  = "https://developers.google.com/oauthplayground"
